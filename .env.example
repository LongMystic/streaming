# Copy to .env and replace every password before running docker compose.

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me
POSTGRES_REPLICATION_USER=replicator
POSTGRES_REPLICATION_PASSWORD=change_me
POSTGRES_APP_USER=app
POSTGRES_APP_PASSWORD=change_me
POSTGRES_READER_USER=reader
POSTGRES_READER_PASSWORD=change_me

# MySQL
MYSQL_ROOT_PASSWORD=change_me
MYSQL_REPLICATION_USER=replicator
MYSQL_REPLICATION_PASSWORD=change_me
MYSQL_APP_USER=app
MYSQL_APP_PASSWORD=change_me
MYSQL_READER_USER=reader
MYSQL_READER_PASSWORD=change_me

# MinIO — lakehouse object storage (passwords/secret keys: at least 8 characters)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change_me
LAKEHOUSE_BUCKET=warehouse
# Non-root key limited to LAKEHOUSE_BUCKET; used by iceberg-rest and the query/compute engines
LAKEHOUSE_S3_ACCESS_KEY=lakehouse
LAKEHOUSE_S3_SECRET_KEY=change_me

# Iceberg REST catalog metastore — Aiven MySQL (from the service's Overview > Connection information)
ICEBERG_DB_HOST=mysql-xxxx.aivencloud.com
ICEBERG_DB_PORT=12345
# Created on first start if missing (createDatabaseIfNotExist)
ICEBERG_DB_NAME=iceberg_catalog
ICEBERG_DB_USER=avnadmin
ICEBERG_DB_PASSWORD=change_me
